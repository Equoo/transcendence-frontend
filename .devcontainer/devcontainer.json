{
	"name": "TS",
	"remoteUser": "root",
	"updateRemoteUserUID": true,
	"build": {
		"dockerfile": "./Dockerfile"
	},
	"features": {},
	"customizations": {
		"vscode": {
			"settings": {
				"editor.formatOnSave": true,
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"zsh": {
						"path": "/bin/zsh"
					}
				},
				"remote.autoForwardPorts": false,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"typescript.tsdk": "node_modules/typescript/lib"
			},
			"extensions": [
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"dsznajder.es7-react-js-snippets"
			]
		}
	},
	"runArgs": ["--network=bridge", "-p=5173:5173"],
	"postCreateCommand": "hooks/install-hook.sh; if [ -f './package.json' ]; then npm install; fi",
	"initializeCommand": "echo \"BACKEND_IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' keepgrouped-backend-dev)\" > .env.development"
}
